#!/usr/bin/env python3
"""Set each monitor's wallpaper to a recent NASA Astronomy Picture of the Day."""

import itertools
import json
import os
import re
import subprocess
import time
import urllib.parse
import urllib.request
from pathlib import Path

from PIL import Image, ImageOps

APOD_API = "https://science.nasa.gov/wp-json/wp/v2/apod-basic"
DOWNLOADS_PATH = Path("/tmp/apodesktop")
# GNOME stores the wallpaper URI. A file in /tmp would be gone after a reboot,
# and GNOME would show only its fallback color.
WALLPAPERS_PATH = Path.home() / ".local/share/apodesktop"
# The systemd service has no start timeout, so a stalled request would hang it forever.
TIMEOUT_SECONDS = 60


def get_monitors():
    """Return the geometry of each enabled monitor, primary monitor first."""
    xrandr = subprocess.check_output(["xrandr", "--query"], text=True)
    monitors = []
    for line in xrandr.splitlines():
        match = re.search(r" connected (primary )?(\d+)x(\d+)\+(\d+)\+(\d+)", line)
        if match:
            primary, w, h, x, y = match.groups()
            monitor = {"w": int(w), "h": int(h), "x": int(x), "y": int(y)}
            monitors.insert(0 if primary else len(monitors), monitor)
    return monitors


def get_image_urls(count):
    """Return image URLs of the `count` most recent APOD entries, newest first."""
    url = f"{APOD_API}?per_page={count}"
    with urllib.request.urlopen(url, timeout=TIMEOUT_SECONDS) as response:
        entries = json.load(response)
    # The API returns entries newest first. `url` is an article page, so use `hdurl`.
    return [entry["hdurl"] for entry in entries if entry["media_type"] == "image"]


def download(urls):
    """Download each URL into DOWNLOADS_PATH (reusing earlier downloads) and return the paths."""
    DOWNLOADS_PATH.mkdir(exist_ok=True)
    paths = []
    for url in urls:
        name = urllib.parse.unquote(Path(urllib.parse.urlparse(url).path).name)
        path = DOWNLOADS_PATH / name
        if not path.exists():
            try:
                with urllib.request.urlopen(url, timeout=TIMEOUT_SECONDS) as response:
                    path.write_bytes(response.read())
            except OSError as error:
                # Happens in practice: the old APOD host returned 403 and 404 for some images.
                print(f"Skipping {url}: {error}")
                continue
        paths.append(path)
    return paths


def set_gnome_wallpaper(paths, monitors):
    """GNOME shows one wallpaper across all monitors, so combine one image per monitor."""
    width = max(m["x"] + m["w"] for m in monitors)
    height = max(m["y"] + m["h"] for m in monitors)
    canvas = Image.new("RGB", (width, height))
    for monitor, path in zip(monitors, itertools.cycle(paths)):
        with Image.open(path) as image:
            fitted = ImageOps.fit(image, (monitor["w"], monitor["h"]), Image.Resampling.LANCZOS)
        canvas.paste(fitted, (monitor["x"], monitor["y"]))

    # Use a new filename every run: setting picture-uri to its current value does
    # nothing, so GNOME would keep showing its cached (or fallback) image.
    WALLPAPERS_PATH.mkdir(parents=True, exist_ok=True)
    wallpaper = WALLPAPERS_PATH / f"wallpaper_{time.time_ns()}.jpg"
    canvas.save(wallpaper, quality=95)

    uri = wallpaper.as_uri()
    for key, value in [
        ("picture-options", "spanned"),
        ("picture-uri", uri),
        ("picture-uri-dark", uri),
    ]:
        subprocess.run(["gsettings", "set", "org.gnome.desktop.background", key, value], check=True)

    # Delete old wallpapers only after GNOME points at the new one.
    for old in WALLPAPERS_PATH.iterdir():
        if old != wallpaper:
            old.unlink()


def main():
    monitors = get_monitors()
    assert monitors, "No monitors found"

    # Request two spare entries because some APOD entries are videos.
    urls = get_image_urls(len(monitors) + 2)
    paths = download(urls)
    assert paths, "No images downloaded"
    print(f"Downloaded {len(paths)} images for {len(monitors)} monitors")

    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    session = os.environ.get("GDMSESSION", "").lower()
    # In the i3-gnome session, GNOME Shell doesn't draw the wallpaper.
    if "gnome" in desktop and "i3" not in session:
        set_gnome_wallpaper(paths, monitors)
        print("Set wallpaper with gsettings")
    else:
        subprocess.run(["feh", "--bg-fill", *paths], check=True)
        print("Set wallpaper with feh")


if __name__ == "__main__":
    main()
